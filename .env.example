# Required
TELEGRAM_BOT_TOKEN=

# Runtime
APP_NAME=telegram-file-store
APP_ENV=development
LOG_LEVEL=INFO
TELEGRAM_ADMIN_IDS=
TELEGRAM_STORE_CHANNEL_ID=0
TELEGRAM_ARCHIVE_CHANNEL_ID=0
TELEGRAM_BACKUP_CHANNEL_ID=0

# Infrastructure
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/telegram_file_store
REDIS_URL=redis://localhost:6379/0

# Payments
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
PAYMENT_CALLBACK_URL=
